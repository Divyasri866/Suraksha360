# Suraksha360 Environment Configuration Template
# Copy to .env and configure local variables as needed

# Application Port
PORT=3000

# Emergency SMS Gateway (Optional Twilio / Fast2SMS credentials)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=SURAKSHA360

# Mapping & Telemetry Services (Optional Google Maps API Key)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Central Emergency Dispatch Endpoint (Optional webhook URL)
EMERGENCY_DISPATCH_WEBHOOK_URL=https://api.suraksha360.local/v1/dispatch
